# AI Cascade Router - Environment Variables
# Copy to .env and fill in your API keys

# LM Studio (local) - usually no key needed
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LOCAL_MODEL_NAME=qwen2.5-7b-instruct

# OpenRouter (cloud) - get key from https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Alternative cloud providers (optional)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=